<?xml version="1.0" encoding="utf-8"?>
<!--
  搜索选项行：Aa（区分大小写）/ .*（正则）/ 替换。
  代码页与值编辑弹窗共用同一套结构，配色由 SearchOptionsBar 统一处理，
  保证两处的观感一致。

  用 <merge> 是因为两个宿主都是 LinearLayout(vertical)，包一层会多出多余层级。
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/searchOptionsRow"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/searchCaseToggle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minWidth="46dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Aa"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/searchRegexToggle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minWidth="46dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text=".*"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/searchReplaceToggle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="替换"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/searchReplaceRow"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/searchReplaceInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="替换为"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:singleLine="true"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/searchReplaceOne"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="替换"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/searchReplaceAll"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="全部"
            android:textSize="12sp" />
    </LinearLayout>
</merge>
