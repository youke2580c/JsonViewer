<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/valueRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/valueTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="@color/editor_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/valuePath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="start"
        android:singleLine="true"
        android:textColor="@color/json_null"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/valueMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/json_null"
        android:textSize="11sp" />

    <!-- 值内搜索：高亮并定位。外层竖向容器同时容纳「Aa / .* / 替换」选项行 -->
    <LinearLayout
        android:id="@+id/searchPanelValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/editor_gutter"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/searchRowValue"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/searchInputValue"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="在值中搜索"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/searchCountValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minWidth="44dp"
            android:text="0/0"
            android:textColor="@color/json_null"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/searchPrevValue"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="上一个"
            android:src="@drawable/ic_arrow_up"
            app:tint="@color/json_null" />

        <ImageButton
            android:id="@+id/searchNextValue"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="下一个"
            android:src="@drawable/ic_arrow_down"
            app:tint="@color/json_null" />

        <ImageButton
            android:id="@+id/searchCloseValue"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭搜索"
            android:src="@drawable/ic_close"
            app:tint="@color/json_null" />
    </LinearLayout>

    <!-- 第二/三行：Aa 区分大小写、.* 正则、替换（与代码页共用同一套结构） -->
    <include layout="@layout/view_search_options" />
    </LinearLayout>

    <!-- 翻译结果：点「翻译」后展开，状态行 + 可选中复制的结果文本（内部独立滚动） -->
    <LinearLayout
        android:id="@+id/translatePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/editor_gutter"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/translateStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/json_null"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/translateCopy"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="复制翻译结果"
                android:src="@drawable/ic_copy"
                app:tint="@color/json_null" />

            <ImageButton
                android:id="@+id/translateClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="关闭翻译"
                android:src="@drawable/ic_close"
                app:tint="@color/json_null" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/translateScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <TextView
                android:id="@+id/translateResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/editor_text"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- 编辑态：值类型（字符串 / 数字 / 布尔 / null / 对象 / 数组），选中项由代码着色 -->
    <HorizontalScrollView
        android:id="@+id/typeRowScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/typeRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- 查看区域：不设独立底色（与弹窗同色）；右侧为可拖动快速滚动的滚动条，平时隐藏、滚动时出现 -->
    <FrameLayout
        android:id="@+id/valueScrollContainer"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="10dp">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/valueScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <TextView
                android:id="@+id/valueFull"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/editor_text"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </androidx.core.widget.NestedScrollView>

        <View
            android:id="@+id/scrollThumb"
            android:layout_width="12dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:layout_marginEnd="1dp"
            android:background="@drawable/scrollbar_thumb"
            android:visibility="gone" />

        <!-- 编辑态：与代码页共用同一个编辑器（高亮/行号/缩放/主题一致） -->
        <com.guaner.jsonviewer.ui.CodeEditorView
            android:id="@+id/valueEditor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 只读态操作 -->
    <LinearLayout
        android:id="@+id/actionRowReadonly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/copyValueButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="复制值" />

        <Space
            android:layout_width="8dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/editValueButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="编辑" />

        <Space
            android:layout_width="8dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/translateButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="翻译" />

        <Space
            android:layout_width="8dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/copyPathButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="复制路径" />
    </LinearLayout>

    <!-- 编辑态操作 -->
    <LinearLayout
        android:id="@+id/actionRowEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/resetValueButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="重置" />

        <Space
            android:layout_width="8dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/cancelEditButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="取消" />

        <Space
            android:layout_width="8dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/saveValueButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="保存" />
    </LinearLayout>

</LinearLayout>
